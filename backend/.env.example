# Copy to .env and fill in real values — never commit .env

# App
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me

# GitHub (choose one auth method)
GITHUB_TOKEN=ghp_...                   # Personal Access Token (simpler)
GITHUB_APP_ID=                         # GitHub App ID (production)
GITHUB_PRIVATE_KEY_PATH=certs/github-app.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Redis
REDIS_URL=redis://localhost:6379/0

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel

# HuggingFace (local app inference only; Modal jobs use the Modal secret below)
HF_TOKEN=hf_...
CODELLAMA_BASE_MODEL=codellama/CodeLlama-7b-Instruct-hf
CODELLAMA_FINETUNED_MODEL=           # set after Modal fine-tuning
SECURITY_CLASSIFIER_MODEL=           # set after Modal training

# Device (cpu / cuda)
DEVICE=cpu

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0XXXXXXXXX

# Modal
MODAL_WORKSPACE=your-modal-workspace
# GPU jobs read HF_TOKEN from this Modal secret (not from local .env):
#   modal secret create sentinel HF_TOKEN=hf_...
MODAL_SECRET_NAME=sentinel
